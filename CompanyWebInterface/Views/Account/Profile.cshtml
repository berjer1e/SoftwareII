@model ProfileViewModel
@{
    ViewData["Title"] = "Профіль користувача";
}

<h3 class="mb-3">@ViewData["Title"]</h3>

<div class="border p-3 mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Логін</dt>
        <dd class="col-sm-9">@Model.Login</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Роль</dt>
        <dd class="col-sm-9">@Model.RoleDisplayName</dd>

        <dt class="col-sm-3">Баланс</dt>
        <dd class="col-sm-9">@Model.Balance.ToString("N2") грн</dd>

        @if (Model.IssuedUtc.HasValue)
        {
            <dt class="col-sm-3">Сесію видано (UTC)</dt>
            <dd class="col-sm-9">@Model.IssuedUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        }

        @if (Model.ExpiresUtc.HasValue)
        {
            <dt class="col-sm-3">Сесія дійсна до (UTC)</dt>
            <dd class="col-sm-9 mb-0">@Model.ExpiresUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        }
    </dl>
</div>

<h5>Твердження (claims) у cookie</h5>
<div class="border p-3">
    <table class="table table-bordered table-sm mb-0">
        <thead>
            <tr>
                <th>Тип</th>
                <th>Значення</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model.Claims)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
</div>
