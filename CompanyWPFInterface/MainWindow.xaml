<Window x:Class="CompanyWPFInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CompanyWPFInterface.ViewModels"
        xmlns:views="clr-namespace:CompanyWPFInterface.Views"
        Title="QUOTRON WALL STREET // AUCTION MANAGER TERMINAL [VARIANT 21]"
        Width="1380"
        Height="860"
        MinWidth="1120"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CrtBlackBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuctionManagerViewModel}">
            <views:AuctionManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TraderTerminalViewModel}">
            <views:TraderTerminalView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#121212"
                BorderBrush="{StaticResource AmberBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="AUCTION CONTROL DESK "
                               Foreground="{StaticResource AmberBrush}"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Border Background="#070707"
                            BorderBrush="{StaticResource PhosphorGreenBrush}"
                            BorderThickness="1"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding RtcClockText}"
                                   Foreground="{StaticResource PhosphorGreenBrush}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperatorStatusText}"
                               Foreground="{StaticResource TerminalTextBrush}"
                               FontWeight="Bold"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BalanceStatusText}"
                               Foreground="{StaticResource PhosphorGreenBrush}"
                               FontWeight="Bold"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <Button Content="[ ЗАВЕРШИТИ СЕСІЮ ]"
                            Command="{Binding LogoutCommand}"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource DangerTerminalButtonStyle}"
                            Padding="8,2" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding ViewHandler.CurrentView}" />
    </Grid>
</Window>
