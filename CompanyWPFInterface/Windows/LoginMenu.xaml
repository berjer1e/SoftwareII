<Page x:Class="CompanyWPFInterface.Windows.LoginMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:CompanyWPFInterface.Helpers"
      mc:Ignorable="d"
      Title="LoginMenu" Height="520" Width="800">
    <Grid>
        <Border Width="360"
                Padding="20"
                Style="{StaticResource SectionBorderStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding TitleText}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBlock Text="Логін:" Margin="0,0,0,4" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Margin="0,0,0,18" />

                <TextBlock Text="Пароль:" Margin="0,0,0,4" />
                <PasswordBox helpers:PasswordBoxAssistant.BindPassword="True"
                             helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Margin="0,0,0,18" />

                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,18">
                    <TextBlock Text="Повторіть пароль:" Margin="0,0,0,4" />
                    <PasswordBox helpers:PasswordBoxAssistant.BindPassword="True"
                                 helpers:PasswordBoxAssistant.BoundPassword="{Binding RepeatedPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Green" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="{Binding ActionButtonText}"
                        Command="{Binding ActionCommand}"
                        Height="32"
                        Margin="0,0,0,10" />

                <Button Content="{Binding ToggleModeButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
