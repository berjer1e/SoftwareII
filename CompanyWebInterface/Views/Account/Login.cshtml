@model LoginViewModel
@{
    ViewData["Title"] = "Вхід до системи";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="border p-4 mt-3">
            <h4 class="text-center mb-3">@ViewData["Title"]</h4>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Login" class="form-label"></label>
                    <input asp-for="Login" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-outline-dark w-100 mb-2">Увійти</button>
                <div class="text-center">
                    <a asp-action="Register" class="text-secondary">Немає акаунту? Зареєструватися</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
